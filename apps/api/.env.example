# Copy to .env and fill in. Every value is validated at boot (src/config/config.ts).

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://qilo:qilo@localhost:5432/qilo
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=*
# Public URL of this API (used for local development upload links).
PUBLIC_BASE_URL=http://localhost:3000

# Supabase (Project Settings -> API). Set SUPABASE_JWT_SECRET for projects that
# sign tokens with the legacy HS256 secret, or leave it empty to verify against
# the project's JWKS (asymmetric signing keys) via SUPABASE_URL.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=
# Server-only. Used for signed media uploads and account deletion. Never ship it to clients.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=qilo-media

# Comma-separated Supabase user ids that get the moderator role.
ADMIN_SUBJECTS=

# Game timing (milliseconds). Defaults follow spec Appendix A.
COUNTDOWN_MS=3000
PLAYER_GRACE_MS=60000
HOST_GRACE_MS=60000
HOST_PAUSE_MAX_MS=300000
LOBBY_EXPIRY_MS=1800000
ROOM_MAX_PLAYERS_CAP=50

# Set to false on instances that should not run timer workers or housekeeping.
RUN_WORKERS=true
RUN_MAINTENANCE=true
# Run migrations and seed starter quizzes on boot (idempotent).
MIGRATE_ON_BOOT=true
